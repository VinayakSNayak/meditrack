rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // USERS COLLECTION — each user can only access own data
    // =====================================================
    match /users/{userId} {

      // User can only read/write their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // =====================================================
      // MEMBERS sub-collection
      // =====================================================
      match /members/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Validate member data on write
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['name', 'relation'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;

        allow update: if request.auth != null
          && request.auth.uid == userId;

        // =====================================================
        // PRESCRIPTIONS sub-collection
        // =====================================================
        match /prescriptions/{prescriptionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          // Validate prescription data on create
          allow create: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.keys().hasAll(['medicineName', 'foodTiming'])
            && request.resource.data.medicineName is string
            && request.resource.data.medicineName.size() > 0;

          // Daily status sub-collection
          match /dailyStatus/{dateId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;

            allow create, update: if request.auth != null
              && request.auth.uid == userId
              && request.resource.data.status in ['taken', 'missed', 'snoozed', 'pending'];
          }
        }

        // =====================================================
        // BODY VITALS sub-collection
        // =====================================================
        match /bodyVitals/{vitalId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          allow create: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.keys().hasAll(['type', 'value', 'unit'])
            && request.resource.data.type is string;
        }

        // =====================================================
        // BLOOD RECORDS sub-collection
        // =====================================================
        match /bloodRecords/{recordId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // =====================================================
        // CONDITIONS sub-collection
        // =====================================================
        match /conditions/{conditionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          allow create: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.keys().hasAll(['conditionName', 'status'])
            && request.resource.data.conditionName is string
            && request.resource.data.conditionName.size() > 0;
        }

        // =====================================================
        // OTHER RECORDS sub-collection
        // =====================================================
        match /otherRecords/{recordId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

